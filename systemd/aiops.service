[Unit]
Description=AI Operations Center (Docker Compose stack)
Documentation=https://github.com/bashirmohammedatiwi-ops/NORAAI
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/aiops
EnvironmentFile=-/opt/aiops/.env
ExecStart=/bin/bash /opt/aiops/scripts/ensure_services.sh start
ExecStop=/usr/bin/docker compose -f /opt/aiops/docker-compose.prod.yml stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
