# =============================================================================
# AI Operations Center — Production Environment (VPS)
# Copy to .env on your server:  cp .env.production.example .env
# =============================================================================

APP_NAME=AI Operations Center
APP_ENV=production

# IMPORTANT: change before deploy!
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (internal Docker network — do NOT expose 5432)
POSTGRES_USER=aiops
POSTGRES_PASSWORD=CHANGE_STRONG_DB_PASSWORD
POSTGRES_DB=aiops
DATABASE_URL=postgresql+asyncpg://aiops:CHANGE_STRONG_DB_PASSWORD@postgres:5432/aiops
DATABASE_URL_SYNC=postgresql://aiops:CHANGE_STRONG_DB_PASSWORD@postgres:5432/aiops

# Redis (internal)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_MINIO_USER
MINIO_SECRET_KEY=CHANGE_MINIO_PASSWORD
MINIO_BUCKET=aiops-data
MINIO_SECURE=false

# Quality / ML
QUALITY_SCORE_THRESHOLD=40
ACTIVE_LEARNING_CONFIDENCE_THRESHOLD=0.70
CUDA_VISIBLE_DEVICES=0
TRAINING_CPU_FALLBACK=true

# Monitoring
PROMETHEUS_ENABLED=true

# Admin seed user
ADMIN_EMAIL=admin@aiops.com
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_GRAFANA_PASSWORD

# ---- VPS Port mapping ----
# NOTE: Do NOT use port 6000 for the app — Chrome blocks it (ERR_UNSAFE_PORT, X11 port).
PORT_APP=8080
PORT_API=6001
PORT_MINIO_API=6002
PORT_MINIO_CONSOLE=6003
PORT_GRAFANA=6004
PORT_PROMETHEUS=6005

# Public URL (replace YOUR_VPS_IP with actual IP or domain)
PUBLIC_URL=http://YOUR_VPS_IP:8080

# Training worker: use Dockerfile.gpu only if NVIDIA GPU available
TRAINING_DOCKERFILE=Dockerfile
