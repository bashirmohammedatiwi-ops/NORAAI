# NORAAI Desktop EXE — max performance (CPU + Intel iGPU via DirectML).
APP_NAME=NORAAI Desktop
APP_ENV=production
SECRET_KEY=desktop-local-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=aiops
POSTGRES_PASSWORD=
POSTGRES_DB=aiops
DATABASE_URL=postgresql+asyncpg://aiops@127.0.0.1:5432/aiops
DATABASE_URL_SYNC=postgresql://aiops@127.0.0.1:5432/aiops

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiops-data-desktop
MINIO_SECURE=false

# auto = CUDA > Intel DirectML > CPU
TRAINING_DEVICE=auto
TRAINING_CPU_FALLBACK=false
TRAINING_CPU_THREADS=0
TRAINING_AUTO_BATCH=true
TRAINING_SKIP_ONNX_EXPORT=true
INFERENCE_DEVICE=auto
INFERENCE_USE_HALF=false
PROMETHEUS_ENABLED=false
DESKTOP_MODE=true

ADMIN_EMAIL=admin@aiops.com
ADMIN_PASSWORD=admin123
PUBLIC_URL=http://127.0.0.1:8000
