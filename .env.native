# Native Windows stack (no Docker) — fully local, separate from VPS.
APP_NAME=AI Operations Center (Native Local)
APP_ENV=development
SECRET_KEY=native-local-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=aiops
POSTGRES_PASSWORD=
POSTGRES_DB=aiops
DATABASE_URL=postgresql+asyncpg://aiops@127.0.0.1:5432/aiops
DATABASE_URL_SYNC=postgresql://aiops@127.0.0.1:5432/aiops

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiops-data-native
MINIO_SECURE=false

TRAINING_CPU_THREADS=0
TRAINING_AUTO_BATCH=true
TRAINING_SPEED_BOOST=true
TRAINING_AUTO_BATCH=true
TRAINING_CPU_FALLBACK=true
INFERENCE_DEVICE=cpu
PROMETHEUS_ENABLED=false

ADMIN_EMAIL=admin@aiops.com
ADMIN_PASSWORD=admin123
PUBLIC_URL=http://localhost:5173
