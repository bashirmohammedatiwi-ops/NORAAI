# Local training worker — uses YOUR PC CPU/GPU, saves models to VPS.
# 1) On VPS: run scripts/enable_vps_remote_training.sh
# 2) On PC:  scripts/tunnel_vps.ps1  (keep window open)
# 3) On PC:  copy this file to .env.local-worker and fill VPS values
# 4) On PC:  scripts/start_local_training_worker.ps1

APP_ENV=development

# --- VPS credentials (same as VPS /opt/aiops/.env) ---
VPS_HOST=YOUR_VPS_IP
VPS_SSH_USER=root

POSTGRES_USER=aiops
POSTGRES_PASSWORD=CHANGE_STRONG_DB_PASSWORD
POSTGRES_DB=aiops

MINIO_ACCESS_KEY=CHANGE_MINIO_USER
MINIO_SECRET_KEY=CHANGE_MINIO_PASSWORD
MINIO_BUCKET=aiops-data

# --- Via SSH tunnel (scripts/tunnel_vps.ps1) — defaults match tunnel script ---
DATABASE_URL=postgresql+asyncpg://aiops:CHANGE_STRONG_DB_PASSWORD@127.0.0.1:15432/aiops
DATABASE_URL_SYNC=postgresql://aiops:CHANGE_STRONG_DB_PASSWORD@127.0.0.1:15432/aiops
REDIS_URL=redis://127.0.0.1:16379/0
CELERY_BROKER_URL=redis://127.0.0.1:16379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:16379/2

# MinIO is exposed on VPS port 6002 — direct connection (no tunnel)
MINIO_ENDPOINT=YOUR_VPS_IP:6002
MINIO_SECURE=false

# Use all local CPU cores (0 = auto-detect)
TRAINING_CPU_THREADS=0
TRAINING_AUTO_BATCH=true
TRAINING_SPEED_BOOST=true
TRAINING_CPU_FALLBACK=true
CUDA_VISIBLE_DEVICES=0

# Dummy secret — worker does not serve HTTP; must match VPS if validating tokens (unused by worker)
SECRET_KEY=local-worker-not-serving-api
