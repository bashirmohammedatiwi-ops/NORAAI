# Standalone local stack — fully separate from VPS (own DB, Redis, MinIO, models).
# Used by: docker compose -f docker-compose.standalone.yml --env-file .env.standalone

APP_NAME=AI Operations Center (Local)
APP_ENV=development
SECRET_KEY=local-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_local_secret
POSTGRES_DB=aiops
DATABASE_URL=postgresql+asyncpg://aiops:aiops_local_secret@postgres:5432/aiops
DATABASE_URL_SYNC=postgresql://aiops:aiops_local_secret@postgres:5432/aiops

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiops-data-local
MINIO_SECURE=false

QUALITY_SCORE_THRESHOLD=40
ACTIVE_LEARNING_CONFIDENCE_THRESHOLD=0.70

CUDA_VISIBLE_DEVICES=0
TRAINING_CPU_FALLBACK=true
TRAINING_CPU_THREADS=0
TRAINING_AUTO_BATCH=true
TRAINING_SPEED_BOOST=true
INFERENCE_DEVICE=cpu

PROMETHEUS_ENABLED=false
API_UVICORN_WORKERS=1

ADMIN_EMAIL=admin@aiops.com
ADMIN_PASSWORD=admin123

COMPOSE_PROJECT_NAME=aiops-local
PUBLIC_URL=http://localhost:5173
