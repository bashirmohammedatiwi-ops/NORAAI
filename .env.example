# Application
APP_NAME=AI Operations Center
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_secret
POSTGRES_DB=aiops
DATABASE_URL=postgresql+asyncpg://aiops:aiops_secret@postgres:5432/aiops
DATABASE_URL_SYNC=postgresql://aiops:aiops_secret@postgres:5432/aiops

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aiops-data
MINIO_SECURE=false

# Quality thresholds
QUALITY_SCORE_THRESHOLD=40
ACTIVE_LEARNING_CONFIDENCE_THRESHOLD=0.70

# GPU
CUDA_VISIBLE_DEVICES=0
TRAINING_CPU_FALLBACK=true

# Monitoring
PROMETHEUS_ENABLED=true

# Default admin (seed)
ADMIN_EMAIL=admin@aiops.local
ADMIN_PASSWORD=admin123

# ---- VPS Ports (production only, used by docker-compose.prod.yml) ----
PORT_APP=6000
PORT_API=6001
PORT_MINIO_API=6002
PORT_MINIO_CONSOLE=6003
PORT_GRAFANA=6004
PORT_PROMETHEUS=6005
PUBLIC_URL=http://localhost:6000
